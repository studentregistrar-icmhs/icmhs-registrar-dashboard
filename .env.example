# Reuse the SAME service account already used by icmhsdeferment.
# Copy these values straight from that project's Vercel env vars.

GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# Paste the private key with literal \n for newlines (Vercel env vars are single-line)
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nXXXX\n-----END PRIVATE KEY-----\n"

# The Google Sheet ID (the long string in the sheet's URL between /d/ and /edit)
GOOGLE_SHEET_ID=your-sheet-id-here

# Optional: how often the dashboard revalidates data, in seconds (default 120)
REVALIDATE_SECONDS=120
